PORT=4000
NODE_ENV=development

# MySQL — optional in development (defaults: root / no password / biazo_travel)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biazo_travel

# Auth — optional in development (built-in dev secrets used if omitted)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS — comma-separated frontend origins (required in production)
# Include every live client/admin URL (scheme + host, no trailing slash)
CLIENT_ORIGIN=https://biazo.net,https://www.biazo.net,http://localhost:3000,http://127.0.0.1:3000

# Nodemailer (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@biazo.mw
SMTP_PASS=change_me
EMAIL_FROM="Biazo Travel <notifications@biazo.mw>"
